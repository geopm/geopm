[package]
name = "geopmd-proxy"
version = "@VERSION@"
authors = ["Christopher M. Cantalupo <christopher.m.cantalupo@intel.com>"]
edition = "2018"

[[bin]]
name = "geopmd-proxy"
path = "src/geopmd-proxy.rs"

# New exporter binary
[[bin]]
name = "geopmexporter"
path = "src/geopmexporter.rs"

[dependencies]
tonic = "0.8"
prost = "0.11"
tokio = { version = "1.0", features = ["macros", "rt-multi-thread"] }
tokio-stream = { version = "0.1", features = ["net"] }
tower = "0.4"
clap = { version = "4", features = ["derive"] }
prometheus = "0.13"
thiserror = "1"
libc = "0.2"
clap = { version = "4", features = ["derive"] }

[build-dependencies]
tonic-build = "0.8"

[features]
# Link dynamically to system libgeopmd
default = []
