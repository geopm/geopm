[codespell]
skip = googletest-release*,autom4te.cache,./docs/build,./libgeopmd/contrib,libtool*,ltmain*,./integration/apps/*/*,./.git,ChangeLog,*.patch,./test/ProfileTableTest.cpp,configure,config.*,depcomp,*.spec,./*/debian/copyright
ignore-words-list = AtMost,Statics,affinitize,affinitized,atleast,atmost,assertIn,assertin,clos,complies,fom,ois,statics,warmup,whis
